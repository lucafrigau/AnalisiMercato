#: hc/options/deltaG.description.R
msgid "Se TRUE produce il grafico del Delta G (differenza fra altezze di unione successive) al variare di k."
msgstr "If TRUE, produces the Delta G plot (differences between successive merge heights) as k varies."

#: hc/options/ch_index.description.R
msgid "Se TRUE produce il grafico dell'Indice F di Calinski-Harabasz al variare di k."
msgstr "If TRUE, produces the Calinski-Harabasz F-index plot as k varies."

#: hc/options/r2.description.R
msgid "Se TRUE produce il grafico dell'R² al variare di k."
msgstr "If TRUE, produces the R² plot as k varies."

#: hc/options/rmsstd.description.R
